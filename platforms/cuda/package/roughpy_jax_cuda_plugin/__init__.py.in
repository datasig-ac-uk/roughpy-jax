from __future__ import annotations

import jax

from roughpy_jax.ops import Operation

from .@RPJ_CUDA_MODULE_NAME@ import cuda_functions

PLUGIN_VARIANT = "@RPJ_CUDA_VARIANT@"
PLUGIN_VERSION = "@RPJ_CUDA_PLUGIN_VERSION@"
_registered = False


def register() -> None:
    global _registered

    if _registered:
        return

    Operation.register_all(
        platform="cuda",
        ops=cuda_functions,
        supported_dtypes={"float32", "float64"},
        ffi_register_kwargs={},
    )
    _registered = True
